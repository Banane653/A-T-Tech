generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Fini les url et directUrl ici !
}

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String?
  points    Int      @default(0)
  walletId  String   @unique
  createdAt DateTime @default(now())

  @@map("customers")
}