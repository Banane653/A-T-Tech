generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Fini les url et directUrl ici !
}

// 1. On définit les deux rôles possibles
enum Role {
  FOUNDER
  ADMIN
  EMPLOYEE
}

enum LoyaltyType {
  STAMPS
  POINTS
}

// 2. La table des Commerces (Les locataires de ton SaaS)
model Company {
  id             String         @id @default(uuid())
  name           String
  systemType     LoyaltyType    @default(STAMPS)
  
  // --- Nouveaux champs pour la personnalisation ---
  primaryColor   String         @default("#000000") // Couleur hexadécimale (ex: #FF5733)
  textColor      String?        // Couleur du texte sur les boutons (ex: #FFFFFF)
  logoUrl        String?        // Lien vers l'image du logo
  cardTemplate   String         @default("default") 

  //Le taux de conversion pour le système de points (ex: 1 € = X points)
  pointsRatio    Float            @default(1)
  
  // --- Identifiants techniques des "Moules" (Templates) ---
  googleClassId  String?        // L'ID du modèle chez Google Wallet
  applePassId    String?        // Réservé pour la future intégration Apple Wallet
  // ------------------------------------------------
  
  users          MerchantUser[]
  customers      Customer[]
  rewards        Reward[]
  transactions   Transaction[]
  createdAt      DateTime       @default(now())

  @@map("companies")
}

// 3. La table des Utilisateurs (Toi, les patrons, les employés)
model MerchantUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  username  String?  @unique
  role      Role     @default(EMPLOYEE)
  
  // Relation avec la Company (Optionnel car le FOUNDER n'a pas forcément de commerce)
  companyId String?  
  company   Company? @relation(fields: [companyId], references: [id])

  transactions Transaction[]
  
  createdAt DateTime @default(now())

  @@map("merchant_users")
}

// 4. La table des Clients (Ceux qui ont la carte Google Wallet)
model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String?
  birthDate String?
  points    Int      @default(0)
  walletId  String   @unique
  
  // Le client est désormais lié au commerce où il s'est inscrit
  companyId String?  
  company   Company? @relation(fields: [companyId], references: [id])
  transactions Transaction[]
  
  createdAt DateTime @default(now())

  @@map("customers")
}

model Reward {
  id        String   @id @default(uuid())
  name      String
  cost      Int
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("rewards")
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  amount      Int
  description String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  merchantUserId String?
  merchantUser   MerchantUser? @relation(fields: [merchantUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@map("transactions")
}

// 5. La table des appareils Apple (Pour les mises à jour Push Apple Wallet)
model ApplePassRegistration {
  id                      String   @id @default(uuid())
  deviceLibraryIdentifier String   // L'identifiant unique de l'iPhone
  pushToken               String   // Le jeton pour envoyer la notification
  serialNumber            String   // Le walletId du client (ex: WLT-123456)
  passTypeIdentifier      String   // L'identifiant de ta carte Apple (ex: pass.com.ton-saas)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Un iPhone ne peut s'enregistrer qu'une seule fois pour une même carte
  @@unique([deviceLibraryIdentifier, serialNumber])
  @@map("apple_pass_registrations")
}